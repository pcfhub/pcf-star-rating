{
    "schemaVersion": 1,
    "slug": "pcf-star-rating",
    "name": "Star Rating",
    "tagline": "A numeric column as an accessible star rating.",
    "summary": "Draws a whole number or decimal column as a row of stars a user can click or type into. It behaves like a form control: it honours the form's read-only state, column security and the column's own maximum.\n\n- A real radio group: arrow keys, Home, End and Delete all work, and a screen reader hears 3 of 5\n- Half steps only when the column can store them\n- Colours come from CSS custom properties, with high contrast handled\n- No framework in the bundle, which is under 20 KB",
    "category": "input",
    "hosts": ["canvas", "model-driven"],
    "tags": [
        "rating",
        "accessible",
        "keyboard",
        "numeric",
        "themeable"
    ],
    "control": {
        "namespace": "PCFHub",
        "constructor": "StarRating",
        "type": "field",
        "framework": "standard",
        "manifestPath": "StarRating/ControlManifest.Input.xml"
    },
    "links": {
        "homepage": "https://github.com/pcfhub/pcf-star-rating",
        "support": "https://github.com/pcfhub/pcf-star-rating/issues",
        "license": "MIT"
    },
    "docs": {
        "path": "docs"
    },
    "media": {
        "logo": "media/logo.png",
        "screenshots": ["media/screenshot.png"]
    },
    "demo": {
        "fidelity": "full",
        "bundle": "out/controls/StarRating/bundle.js",
        "styles": [
            "out/controls/StarRating/css/StarRating.css"
        ],
        "presets": [
            {
                "slug": "default",
                "name": "Default",
                "description": "Five stars on a whole number column, three selected.",
                "props": {
                    "value": 3,
                    "max": 5,
                    "allowHalf": false,
                    "shape": "star",
                    "size": "medium",
                    "showClear": true,
                    "color": "#F2B100"
                },
                "isDefault": true
            },
            {
                "slug": "half-steps",
                "name": "Half steps",
                "description": "A decimal column with half values enabled, in a custom colour - click the left half of an icon.",
                "props": {
                    "value": 3.5,
                    "max": 5,
                    "allowHalf": true,
                    "shape": "star",
                    "size": "large",
                    "showClear": true,
                    "color": "#0F6CBD"
                }
            },
            {
                "slug": "hearts-ten",
                "name": "Ten hearts",
                "description": "A different shape, scale and colour, with the clear button switched off.",
                "props": {
                    "value": 7,
                    "max": 10,
                    "allowHalf": false,
                    "shape": "heart",
                    "size": "small",
                    "showClear": false,
                    "color": "#C4314B"
                }
            },
            {
                "slug": "empty",
                "name": "Not rated",
                "description": "The empty state — no icon filled, and no clear button until there is something to clear.",
                "props": {
                    "value": null,
                    "max": 5,
                    "allowHalf": false,
                    "shape": "circle",
                    "size": "medium",
                    "showClear": true,
                    "color": "#F2B100"
                }
            }
        ]
    }
}
